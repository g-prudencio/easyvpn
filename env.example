# easy-vpn-web/.env.example
#
# Copy this file to easy-vpn-web/.env and fill in your values,
# OR set these directly in docker-compose.yml under `environment:`.
#
# Never commit the real .env file — it is listed in .gitignore.

# ── Required — change both of these before starting ──────────────────────────

# Used to sign Flask session cookies. Use a long random string.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Password to log in to the web UI
ADMIN_PASSWORD=replace-with-a-strong-password
